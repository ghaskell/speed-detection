# =============================================================================
# Vehicle Speed & Traffic Detection - Configuration
# =============================================================================
# Copy this file to .env and update with your settings:
#   cp .env.example .env
#   nano .env
# =============================================================================

# -----------------------------------------------------------------------------
# CAMERA CONFIGURATION
# -----------------------------------------------------------------------------

# RTSP stream URL from your IP camera
# - Use Channel 2 (substream) for lower CPU usage
# - Use Channel 1 (mainstream) for higher quality captures
# 
# Common formats:
#   Hikvision: rtsp://user:pass@IP:554/Streaming/Channels/2
#   Dahua:     rtsp://user:pass@IP:554/cam/realmonitor?channel=1&subtype=1
#   Amcrest:   rtsp://user:pass@IP:554/cam/realmonitor?channel=1&subtype=1
#   Reolink:   rtsp://user:pass@IP:554/h264Preview_01_sub
#   Generic:   rtsp://user:pass@IP:554/stream
#
RTSP_URL=rtsp://admin:your_password@192.168.1.100:554/Streaming/Channels/2

# -----------------------------------------------------------------------------
# WEB SERVER
# -----------------------------------------------------------------------------

# Port for the web interface (default: 8080)
# Access at http://your-server-ip:8080
WEB_PORT=8080

# -----------------------------------------------------------------------------
# SPEED LIMITS
# -----------------------------------------------------------------------------

# Default speed limit in mph when no schedule is active
# School zone schedules can override this (configure in web UI at /schedules)
DEFAULT_SPEED_LIMIT=30

# -----------------------------------------------------------------------------
# DETECTION TUNING
# -----------------------------------------------------------------------------

# Confidence threshold for vehicle detection (0.0 - 1.0)
# - Lower (0.3): Detect more vehicles, more false positives
# - Default (0.5): Balanced
# - Higher (0.7): Fewer false positives, may miss some vehicles
CONFIDENCE_THRESHOLD=0.5

# Process every Nth frame (higher = less CPU, lower accuracy)
# - 1: Process every frame (highest accuracy, highest CPU)
# - 2: Process every other frame (recommended)
# - 3: Process every 3rd frame (lower CPU, may miss fast vehicles)
PROCESS_EVERY_N_FRAMES=2

# -----------------------------------------------------------------------------
# PHOTO RETENTION
# -----------------------------------------------------------------------------

# Captured photos (speeders, violations, hard braking) older than this are
# deleted automatically. 0 = keep forever (default: 24)
PHOTO_RETENTION_HOURS=24

# How often the cleanup runs, in minutes (default: 15)
PHOTO_CLEANUP_INTERVAL_MINUTES=15

# -----------------------------------------------------------------------------
# DATABASE & EVIDENCE
# -----------------------------------------------------------------------------

# Every vehicle pass is stored in data/traffic.db. Photos of the fastest major
# speeders each day are also kept in data/evidence/, which photo cleanup skips.
EVIDENCE_SPEEDERS_PER_DAY=20

# Vehicle color via CLIP in a background process (0 = off)
VEHICLE_COLOR=1

# Readings above this (mph) are treated as tracking errors and never kept as evidence
MAX_PLAUSIBLE_SPEED=80
